<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/node.svg" type="image/x-icon" />
    <title>404</title>
    <style>
      * {
        box-sizing: border-box;
        user-select: none;
        padding: 0;
        margin: 0;
        scrollbar-width: none;
      }

      html {
        color-scheme: light dark;
        color: light-dark(#000000, #ffffff);
        background-color: light-dark(#eeeeee, #222222);
        font-family: monospace;
        font-weight: bold;
      }

      body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 20px;
        align-items: center;
        font-family: sans-serif;
        height: 100dvh;
        min-height: 300px;
        min-width: 250px;
        text-align: center;
        padding: 10px;
        overflow: auto;
      }

      img {
        width: 200px;
        display: block;
        filter: drop-shadow(0 0 100px dodgerblue);
      }

      h2 {
        color: dodgerblue;
        font-size: 2rem;
        white-space: nowrap;
        font-weight: bolder;
      }

      p {
        color: light-dark(#aaa, #777);
      }

      .pathname {
        color: #1e90ff95;
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <img src="/x.svg" alt="404" />
    <h2>404 Not Found</h2>
    <p><span class="pathname"><%= pathname %></span> endpoint not exist</p>
  </body>
</html>
